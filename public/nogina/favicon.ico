<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="32" height="32">
  <defs>
    <linearGradient id="gold-icon" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stopColor="#FFF2D6" />
      <stop offset="50%" stopColor="#E5C385" />
      <stop offset="100%" stopColor="#C99D53" />
    </linearGradient>
  </defs>
  <rect width="32" height="32" rx="7" fill="#0B0B0E" />
  
  <!-- Architectural Arch Portal -->
  <path d="M 7 15 C 7 9.5 11 5.5 16 5.5 C 21 5.5 25 9.5 25 15 L 25 26 C 25 26.5 24.5 27 24 27 L 8 27 C 7.5 27 7 26.5 7 26 Z" stroke="url(#gold-icon)" stroke-width="1.2" fill="rgba(229, 195, 133, 0.08)" />
  
  <!-- Zenith Star -->
  <path d="M 16 2.5 L 16.6 4 L 18 4.6 L 16.6 5.2 L 16 6.7 L 15.4 5.2 L 14 4.6 L 15.4 4 Z" fill="url(#gold-icon)" />
  
  <!-- Monogram Н -->
  <!-- Left stem -->
  <line x1="12" y1="12" x2="12" y2="23" stroke="url(#gold-icon)" stroke-width="1.3" stroke-linecap="round" />
  <line x1="10.8" y1="12" x2="13.2" y2="12" stroke="url(#gold-icon)" stroke-width="0.9" stroke-linecap="round" />
  <line x1="10.8" y1="23" x2="13.2" y2="23" stroke="url(#gold-icon)" stroke-width="0.9" stroke-linecap="round" />
  
  <!-- Right stem -->
  <line x1="20" y1="12" x2="20" y2="23" stroke="url(#gold-icon)" stroke-width="1.3" stroke-linecap="round" />
  <line x1="18.8" y1="12" x2="21.2" y2="12" stroke="url(#gold-icon)" stroke-width="0.9" stroke-linecap="round" />
  <line x1="18.8" y1="23" x2="21.2" y2="23" stroke="url(#gold-icon)" stroke-width="0.9" stroke-linecap="round" />
  
  <!-- Center bar with diamond -->
  <line x1="12" y1="17.5" x2="20" y2="17.5" stroke="url(#gold-icon)" stroke-width="1.1" />
  <polygon points="16,16.4 17,17.5 16,18.6 15,17.5" fill="url(#gold-icon)" />
</svg>
